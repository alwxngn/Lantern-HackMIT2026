# Copy to cloud/web/.env.local. Vite does not load this file.
# Restart the dev server after changing .env.local.

# Public HTTPS origin for QR codes when the laptop browser is on localhost
# and a tunnel is forwarding to Vite. Example:
# VITE_PUBLIC_ORIGIN=https://YOUR-SUBDOMAIN.trycloudflare.com

# Optional WebSocket override. Leave unset to use the page origin + /ws.
# VITE_WS_URL=
